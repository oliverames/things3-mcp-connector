{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "things3-mcp-connector",
  "main": "src/index.js",
  "account_id": "059585806715245840e5581f7174246d",
  "workers_dev": false,
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "things3mcp.org", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "0ac01283159e43389b0554119d5e3438" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "ThingsMCP" },
      { "name": "OAUTH_CREDENTIALS", "class_name": "OAuthCredentials" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ThingsMCP", "OAuthCredentials"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CONNECTOR_BASE_URL": "https://things3mcp.org",
    "USER_TIMEZONE": "America/New_York",
    "MCP_ALLOWED_ORIGINS": "https://chatgpt.com,https://claude.ai,https://claude.com,https://chat.mistral.ai,https://lechat.mistral.ai",
    "COOKIE_ENCRYPTION_KEY": "REMOVED_SECRET",
    "DATA_ENCRYPTION_KEY": "REMOVED_SECRET"
  }
}
